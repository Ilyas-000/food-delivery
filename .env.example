# =============================================================================
# Food Delivery - Environment Variables
# =============================================================================
# Copy this file to .env and update with your actual values
# NEVER commit .env file to version control

# =============================================================================
# General Settings
# =============================================================================
ENVIRONMENT=development  # development | staging | production
DEBUG=true
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR | CRITICAL

# =============================================================================
# PostgreSQL Configuration
# =============================================================================
# Master connection (for infrastructure setup)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432  # Change to 5433 if 5432 is already in use
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_change_me

# pgAdmin (optional)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# Service-specific databases
USER_SERVICE_DB_NAME=user_service_db
USER_SERVICE_DB_USER=user_service_user
USER_SERVICE_DB_PASSWORD=user_service_password_change_me
RESTAURANT_SERVICE_DB_NAME=restaurant_service_db
ORDER_SERVICE_DB_NAME=order_service_db
PAYMENT_SERVICE_DB_NAME=payment_service_db
DELIVERY_SERVICE_DB_NAME=delivery_service_db
NOTIFICATION_SERVICE_DB_NAME=notification_service_db
REVIEW_SERVICE_DB_NAME=review_service_db

# Connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# Redis for different purposes
REDIS_CACHE_DB=0
REDIS_SESSION_DB=1
REDIS_PUBSUB_DB=2

# =============================================================================
# Kafka Configuration
# =============================================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9093
KAFKA_ADVERTISED_HOST=localhost
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Kafka Producer Settings
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_RETRIES=3
KAFKA_PRODUCER_MAX_IN_FLIGHT_REQUESTS=5

# Kafka Consumer Settings
KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest
KAFKA_CONSUMER_ENABLE_AUTO_COMMIT=false
KAFKA_CONSUMER_SESSION_TIMEOUT_MS=30000
KAFKA_CONSUMER_MAX_POLL_RECORDS=500

# Consumer Group IDs
USER_SERVICE_CONSUMER_GROUP=user-service-group
RESTAURANT_SERVICE_CONSUMER_GROUP=restaurant-service-group
ORDER_SERVICE_CONSUMER_GROUP=order-service-group
PAYMENT_SERVICE_CONSUMER_GROUP=payment-service-group
DELIVERY_SERVICE_CONSUMER_GROUP=delivery-service-group
NOTIFICATION_SERVICE_CONSUMER_GROUP=notification-service-group
ANALYTICS_SERVICE_CONSUMER_GROUP=analytics-service-group

# =============================================================================
# ClickHouse Configuration (Analytics)
# =============================================================================
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=analytics_db

# =============================================================================
# JWT & Authentication
# =============================================================================
JWT_SECRET_KEY=your-super-secret-jwt-key-change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Password hashing
PASSWORD_BCRYPT_ROUNDS=12

# =============================================================================
# API Gateway
# =============================================================================
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8000
API_GATEWAY_WORKERS=4

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true

# =============================================================================
# Microservices Ports
# =============================================================================
USER_SERVICE_PORT=8001
RESTAURANT_SERVICE_PORT=8002
ORDER_SERVICE_PORT=8003
PAYMENT_SERVICE_PORT=8004
DELIVERY_SERVICE_PORT=8005
NOTIFICATION_SERVICE_PORT=8006
ANALYTICS_SERVICE_PORT=8007
REVIEW_SERVICE_PORT=8008

# Service URLs (internal communication)
USER_SERVICE_URL=http://localhost:8001
RESTAURANT_SERVICE_URL=http://localhost:8002
ORDER_SERVICE_URL=http://localhost:8003
PAYMENT_SERVICE_URL=http://localhost:8004
DELIVERY_SERVICE_URL=http://localhost:8005
NOTIFICATION_SERVICE_URL=http://localhost:8006
ANALYTICS_SERVICE_URL=http://localhost:8007
REVIEW_SERVICE_URL=http://localhost:8008

# =============================================================================
# Payment Service (Mock/Sandbox)
# =============================================================================
PAYMENT_PROVIDER=mock  # mock | stripe | paypal
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Stripe (if used)
STRIPE_API_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# =============================================================================
# Notification Service
# =============================================================================
# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@fooddelivery.com
SMTP_FROM_NAME=Food Delivery
SMTP_USE_TLS=true

# Push Notifications (FCM)
FCM_SERVER_KEY=your-fcm-server-key
FCM_SENDER_ID=your-sender-id

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# =============================================================================
# Delivery Service
# =============================================================================
# WebSocket
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_MAX_CONNECTIONS=1000

# Geolocation
GEOLOCATION_UPDATE_INTERVAL_SECONDS=10
GEOLOCATION_PRECISION_METERS=10

# =============================================================================
# Monitoring & Observability
# =============================================================================
# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_ENABLED=true
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Jaeger (Distributed Tracing)
JAEGER_ENABLED=false
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# Sentry (Error Tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# =============================================================================
# Testing
# =============================================================================
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/test_db  # Keep in sync with POSTGRES_PORT
TEST_REDIS_URL=redis://localhost:6379/15
TEST_KAFKA_BOOTSTRAP_SERVERS=localhost:9093

# =============================================================================
# Feature Flags (for gradual rollout)
# =============================================================================
FEATURE_WEBSOCKET_TRACKING=true
FEATURE_PUSH_NOTIFICATIONS=false
FEATURE_SMS_NOTIFICATIONS=false
FEATURE_ANALYTICS_REALTIME=true

# =============================================================================
# Performance & Scaling
# =============================================================================
# Service workers (uvicorn)
UVICORN_WORKERS=1  # Set to CPU count in production
UVICORN_RELOAD=true  # Set to false in production

# Request timeout (seconds)
REQUEST_TIMEOUT=30
SAGA_TIMEOUT=60

# Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60
CIRCUIT_BREAKER_EXPECTED_EXCEPTION=httpx.RequestError

# =============================================================================
# Development Tools
# =============================================================================
# Auto-reload on code changes
AUTO_RELOAD=true

# Profiling
PROFILING_ENABLED=false

# SQL Query Logging
SQL_ECHO=false  # Set to true to log all SQL queries
